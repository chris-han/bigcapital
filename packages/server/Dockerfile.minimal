# Stage 1: Build
FROM node:18.16.0-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm@9.0.5

# Install build essentials for native modules that might be needed during build
RUN apk add --no-cache python3 build-base

# Copy package files
COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml lerna.json ./
COPY --chown=node:node packages/server/package.json ./packages/server/
COPY --chown=node:node shared ./shared

# Install all dependencies
RUN pnpm install --no-frozen-lockfile

# Copy source code
COPY --chown=node:node ./packages/server ./packages/server

# Build NestJS application
RUN pnpm run build:server

# Stage 2: Production
FROM node:18.16.0-alpine AS production

WORKDIR /app

# No pnpm install in production, we'll copy the node_modules from builder
# but we need to make sure we only have what we need. 
# However, given the pnpm layout, copying node_modules is the safest way to ensure all 
# symlinked dependencies are present.

RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Copy everything from builder (including node_modules with all symlinks)
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/packages/server/node_modules ./packages/server/node_modules
COPY --from=builder --chown=nodejs:nodejs /app/packages/server/dist ./packages/server/dist
COPY --from=builder --chown=nodejs:nodejs /app/packages/server/src/i18n ./packages/server/dist/i18n
COPY --from=builder --chown=nodejs:nodejs /app/packages/server/public ./packages/server/public
COPY --from=builder --chown=nodejs:nodejs /app/packages/server/static ./packages/server/static
COPY --from=builder --chown=nodejs:nodejs /app/packages/server/src/database ./packages/server/src/database
COPY --from=builder --chown=nodejs:nodejs /app/shared ./shared
COPY --from=builder --chown=nodejs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nodejs:nodejs /app/packages/server/package.json ./packages/server/package.json

ENV NODE_ENV=production
ENV PORT=3000

USER nodejs
EXPOSE 3000

# We need to run from the root or set NODE_PATH
CMD [ "node", "packages/server/dist/main.js" ]
